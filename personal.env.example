# Personal, machine-specific build settings -- copy this file to
# personal.env (gitignored, never committed) and fill in real values.
# `make image` reads personal.env automatically if it exists; without it,
# the build produces the exact same image as always (no WiFi configured,
# overscan compensation off), matching the previous "flash it, then
# configure by hand" workflow.
#
# All fields are optional -- leave a line out (or set it empty) to skip
# that piece of personalization.

# Home WiFi the Pi should join on first boot. Without this, WiFi ships
# unconfigured and needs the manual dietpi-wifi.txt edit described in
# README.md's WiFi section.
WIFI_SSID=
WIFI_PASSWORD=

# Overscan compensation: pixels to inset the picture on each edge, to
# compensate for a TV that crops the outer edges of the HDMI signal and has
# no "Just Scan"/1:1 pixel-mapping setting to disable it. Without these
# (or if left at 0), the image ships with overscan compensation off,
# tunable later by hand-editing /etc/default/uxplay on the device -- see
# PROGRESS.md's 2026-09-12 entry for how to measure your own TV's crop.
OVERSCAN_LEFT=0
OVERSCAN_RIGHT=0
OVERSCAN_TOP=0
OVERSCAN_BOTTOM=0
