# Environment for image-builder/*.sh: extract/customize/rebuild a Raspberry
# Pi disk image WITHOUT loop devices or --privileged (see the plan's "No
# privileged containers" rationale). e2fsprogs (debugfs, mke2fs -d),
# dosfstools + mtools (FAT32), fdisk (sfdisk) all operate on plain files.
FROM debian@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

RUN apt-get update && apt-get install -y --no-install-recommends \
    e2fsprogs dosfstools mtools fdisk \
    ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*
