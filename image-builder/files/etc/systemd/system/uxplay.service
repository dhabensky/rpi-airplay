[Unit]
Description=UxPlay AirPlay mirroring receiver
After=network-online.target sound.target time-sync.target
Wants=network-online.target time-sync.target
# Second, cycle-free starter for the menu daemon (the other is
# zero-fb0-late.service's Wants=): a masked one must not silently mean no
# idle menu at all. Pull-in only, no ordering, so no cycle.
Wants=uxplay-menu.service

[Service]
LimitCORE=infinity
WorkingDirectory=/home/uxplay
Environment=HOME=/home/uxplay
Environment=GST_REGISTRY=/home/uxplay/.cache/gstreamer-1.0/registry.bin
Type=simple
User=uxplay
RuntimeDirectory=uxplay
EnvironmentFile=-/etc/default/uxplay
ExecStartPre=/usr/local/bin/zero-fb0
# Without this the journal tags every line "stdbuf", after the wrapper.
SyslogIdentifier=uxplay_debug
# stdbuf execs uxplay_debug rather than wrapping it, so uxplay_debug itself is
# the main process systemd watches: a shell or a filter here would keep the
# unit "active" after uxplay_debug died. Output goes to the journal.
ExecStart=/usr/bin/stdbuf -oL -eL /usr/local/bin/uxplay_debug -vd v4l2h264dec -vc identity -srgb no -n "${UXPLAY_DISPLAY_NAME}" -reset 60 -vs "kmssink qos=false ts-offset=300000000" -as "alsasink device=plughw:vc4hdmi,0" -ofifo /run/uxplay/overscan.fifo -efifo /run/uxplay-events.fifo
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
