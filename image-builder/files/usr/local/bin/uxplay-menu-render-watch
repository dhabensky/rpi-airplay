#!/bin/bash
# Tails /var/log/uxplay.log for disconnect lines and re-renders the idle
# menu immediately, instead of waiting for uxplay-menu-render.timer's
# 5-minute poll. Reads the log only -- never touches uxplay itself.
set -eu

LOG=/var/log/uxplay.log
PATTERN='release_display: hid video|ERROR lost connection with client'
SETTLE_SECS=0.25
RETRY_SECS=1

# -n0: only react to lines appended from now on, not old backlog replayed
# on every (re)start. -F: reattach by name, survives uxplay.service restarts.
tail -F -n0 "$LOG" 2>/dev/null | grep --line-buffered -E "$PATTERN" |
while IFS= read -r _; do
  # Drain further matches within the settle window into one render --
  # collapses a burst from one disconnect without dropping a lone/final
  # one (a fixed cooldown after the last render could drop it instead).
  while IFS= read -r -t "$SETTLE_SECS" _; do :; done
  /usr/local/bin/uxplay-menu-render || true
  # The implicit-disconnect log line can fire just before the TCP socket
  # leaves ESTAB, racing the skip-while-connected check into a no-op
  # (confirmed on real hardware) -- retry once it's had time to clear.
  sleep "$RETRY_SECS"
  /usr/local/bin/uxplay-menu-render || true
done
